{
	"$schema": "./tokens.schema.json",
	"$description": "Fuente única de verdad visual de ArchMac. Consumidores: web/site (CSS), web/simulation (theme.css + colors.config.ts) y, en Fase 2, el shell nativo (QML/GTK). Extraído de la simulación el 2026-07-31.",
	"color": {
		"accent": {
			"$description": "Acentos del sistema. 'blue' es el acento por defecto.",
			"orange": { "light": "hsl(35 100% 50%)", "dark": "hsl(36 100% 52%)" },
			"green": { "light": "hsl(135 59% 49%)", "dark": "hsl(135 64% 50%)" },
			"cyan": { "light": "hsl(199 78% 55%)", "dark": "hsl(197 100% 70%)" },
			"blue": { "light": "hsl(211 100% 50%)", "dark": "hsl(210 100% 52%)" },
			"indigo": { "light": "hsl(241 61% 59%)", "dark": "hsl(241 73% 63%)" },
			"purple": { "light": "hsl(280 68% 60%)", "dark": "hsl(280 85% 65%)" },
			"pink": { "light": "hsl(349 100% 59%)", "dark": "hsl(348 100% 61%)" }
		},
		"surface": {
			"light": "hsl(240 24% 100%)",
			"dark": "hsl(240 3% 11%)",
			"contrastOnLight": "hsl(0 0% 11%)",
			"contrastOnDark": "hsl(240 24% 100%)"
		},
		"grey": {
			"50": "#fafafa",
			"100": "#f5f5f5",
			"200": "#eeeeee",
			"300": "#e0e0e0",
			"400": "#bdbdbd",
			"500": "#9e9e9e",
			"600": "#757575",
			"700": "#616161",
			"800": "#424242",
			"900": "#212121"
		}
	},
	"typography": {
		"family": {
			"ui": "Inter, -apple-system, 'Segoe UI', system-ui, sans-serif",
			"mono": "'JetBrains Mono', ui-monospace, monospace"
		},
		"$note": "Inter es el sustituto libre de SF Pro (decisión cerrada, ver docs/PLAN.md)."
	},
	"radius": {
		"window": "10px",
		"panel": "16px",
		"control": "6px"
	},
	"effect": {
		"blurPanel": "blur(18px) saturate(1.6)",
		"focusRing": "0 0 0 3px <accent al 50%>"
	}
}
